# Google AI API Key (required)
GOOGLE_API_KEY=your-api-key-here

# Model configuration (optional - defaults shown)
LIVE_MODEL=gemini-2.5-flash
WRITER_MODEL=gemini-3-flash-preview
IMAGE_MODEL=imagen-4.0-generate-001
FALLBACK_IMAGE_MODEL=gemini-2.5-flash-image
NARRATION_MODEL=gemini-2.5-flash-tts-preview

# Defaults
DEFAULT_AGE_SETTING=children_5_8
DEFAULT_STYLE=watercolour

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Web Config (for reference)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
